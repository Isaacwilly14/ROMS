<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Order #1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="#D1FAE5"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvOrderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-09-26 14:00"
                android:textSize="12sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer: John Doe"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#334155"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvOrderLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location: Entebbe"
            android:textSize="13sp"
            android:textColor="#475569"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvOrderContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone: 0770000000 | john@example.com"
            android:textSize="13sp"
            android:textColor="#475569"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvOrderTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: UGX 2,500,000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0D9488"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCancelOrder"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Cancel Order"
                android:textSize="12sp"
                android:backgroundTint="#DC2626"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnDeleteOrder"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:tooltipText="Delete this order record permanently"
                android:contentDescription="Delete Order" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>