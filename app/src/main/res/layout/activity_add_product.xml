<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8FAFC">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Product"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product Name *"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#334155"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etProductName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="e.g. Classic Notebook"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:inputType="textCapWords"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SKU / Barcode Code"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#334155"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etProductSku"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="e.g. NB-102"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:inputType="textCapCharacters"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selling Price (UGX) *"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#334155"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etProductPrice"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="e.g. 3500"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Stock Quantity *"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#334155"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etProductStock"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="e.g. 45"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:inputType="number"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnSaveProduct"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="SAVE PRODUCT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#0284C7" />
</LinearLayout>